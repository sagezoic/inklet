{
  "meta": {
    "name": "Inklet Design System",
    "version": "1.0.0",
    "source": "Reference screenshot analysis — rich-text message composer / document editor",
    "lastUpdated": "2026-09-27",
    "aesthetic": "Tactile minimalism / Neo-tactile precision UI",
    "summary": "A calm, premium productivity interface: soft off-white canvas, floating pure-white elevated surfaces, embossed micro-shadows on active controls, and a floating obsidian action dock anchoring the dual-tone architecture."
  },
  "designDirection": {
    "philosophy": "Tactile minimalism — interfaces should feel physical and touchable without visual noise. Soft elevation, hairline borders, and restrained contrast create calm focus. The dark dock is the single strong contrast anchor.",
    "principles": [
      "Airy negative space; never densify chrome",
      "Floating white sheets on pale canvas, not flat full-bleed panels",
      "Active controls are embossed (raised + soft shadow), not filled with brand color",
      "Hairline borders and soft ambient shadows over heavy outlines",
      "Dual-tone: light workspace for content, dark dock for actions",
      "Micro-indicators (corner badges, mention chips) over large status banners",
      "Rounded geometry throughout — pills for actions, 12–24px for cards"
    ],
    "do": [
      "Use soft off-white/light-gray page canvas with pure white elevated cards",
      "Apply embossed micro-shadows on active tactile toggles (e.g. Bold B)",
      "Keep dock icons light-on-dark with even spacing and subtle dividers",
      "Place status badges at media-card corners (success check, loading spinner)",
      "Render @mentions as subtle gray pills inline with body text"
    ],
    "dont": [
      "Do not use purple-to-indigo gradients or glow-heavy neon accents",
      "Do not flatten the dock into a light toolbar — preserve obsidian contrast",
      "Do not use heavy Material elevation stacks or multi-layer dramatic shadows",
      "Do not fill active format buttons with saturated brand color fills",
      "Do not use sharp 0-radius edges or newspaper-style dense columns"
    ]
  },
