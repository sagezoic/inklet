  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "150ms",
      "normal": "220ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "emphasized": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "patterns": [
      {
        "name": "tactilePress",
        "description": "Brief scale 0.98 + inset shadow on press for dock + and format toggles"
      },
      {
        "name": "dockAppear",
        "description": "Dock fades/slides up 8px on editor mount"
      },
      {
        "name": "badgePulse",
        "description": "Loading spinner continuous rotate; success badge soft scale-in"
      }
    ]
  },
  "tailwindIntegration": {
    "description": "Map design tokens to CSS custom properties on :root, then extend Tailwind theme to reference those variables.",
    "cssCustomProperties": {
      ":root": {
        "--font-heading": "'Instrument Serif', Georgia, 'Times New Roman', serif",
        "--font-body": "'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
        "--color-canvas": "#F3F4F6",
        "--color-surface": "#FFFFFF",
        "--color-surface-muted": "#F8F9FA",
        "--color-surface-hover": "#F1F2F4",
        "--color-surface-active": "#EBECEF",
        "--color-ink": "#1A1C1F",
        "--color-ink-secondary": "#5C6068",
        "--color-ink-tertiary": "#8B909A",
        "--color-ink-inverse": "#F7F8FA",
        "--color-border": "#E5E7EB",
        "--color-border-subtle": "#EEF0F3",
        "--color-dock": "#2A2D34",
        "--color-dock-deep": "#1E2025",
        "--color-chip": "#ECEEF1",
        "--color-chip-text": "#2C2F36",
        "--color-focus-ring": "rgba(59, 130, 246, 0.35)",
        "--color-success": "#22C55E",
        "--color-warning": "#F59E0B",
        "--color-error": "#EF4444",
        "--color-info": "#3B82F6",
        "--radius-sm": "6px",
        "--radius-md": "10px",
        "--radius-lg": "14px",
        "--radius-xl": "18px",
        "--radius-2xl": "24px",
        "--radius-full": "9999px",
        "--shadow-card": "0 4px 24px rgba(15, 17, 21, 0.06), 0 1px 2px rgba(15, 17, 21, 0.04)",
        "--shadow-popover": "0 12px 40px rgba(15, 17, 21, 0.12), 0 2px 8px rgba(15, 17, 21, 0.06)",
        "--shadow-tactile": "0 1px 2px rgba(15, 17, 21, 0.08), 0 2px 6px rgba(15, 17, 21, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.9)",
        "--shadow-dock": "0 10px 32px rgba(15, 17, 21, 0.28), 0 2px 8px rgba(15, 17, 21, 0.18)",
        "--shadow-dock-primary": "0 2px 8px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.08)"
      }
    },
    "tailwindThemeExtend": {
      "fontFamily": {
        "heading": ["var(--font-heading)"],
        "sans": ["var(--font-body)"]
      },
      "colors": {
        "canvas": "var(--color-canvas)",
        "surface": {
          "DEFAULT": "var(--color-surface)",
          "muted": "var(--color-surface-muted)",
          "hover": "var(--color-surface-hover)",
          "active": "var(--color-surface-active)"
        },
        "ink": {
          "DEFAULT": "var(--color-ink)",
          "secondary": "var(--color-ink-secondary)",
          "tertiary": "var(--color-ink-tertiary)",
          "inverse": "var(--color-ink-inverse)"
        },
        "border": {
          "DEFAULT": "var(--color-border)",
          "subtle": "var(--color-border-subtle)"
        },
        "dock": {
          "DEFAULT": "var(--color-dock)",
          "deep": "var(--color-dock-deep)"
        },
        "chip": {
          "DEFAULT": "var(--color-chip)",
          "foreground": "var(--color-chip-text)"
        },
        "status": {
          "success": "var(--color-success)",
          "warning": "var(--color-warning)",
          "error": "var(--color-error)",
          "info": "var(--color-info)"
        }
      },
      "borderRadius": {
        "sm": "var(--radius-sm)",
        "md": "var(--radius-md)",
        "lg": "var(--radius-lg)",
        "xl": "var(--radius-xl)",
        "2xl": "var(--radius-2xl)",
        "full": "var(--radius-full)"
      },
      "boxShadow": {
        "card": "var(--shadow-card)",
        "popover": "var(--shadow-popover)",
        "tactile": "var(--shadow-tactile)",
        "dock": "var(--shadow-dock)",
        "dock-primary": "var(--shadow-dock-primary)"
      },
      "ringColor": {
        "focus": "var(--color-focus-ring)"
      }
    },
    "utilityExamples": [
      "bg-canvas text-ink font-sans",
      "bg-surface shadow-card rounded-2xl border border-border",
      "bg-dock shadow-dock rounded-full text-ink-inverse",
      "shadow-tactile bg-surface rounded-md (active Bold toggle)",
      "bg-chip text-chip-foreground rounded-full px-2 py-0.5 font-semibold (mention)",
      "ring-4 ring-focus (focused input)"
    ],
    "googleFontsLinkTag": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap\" rel=\"stylesheet\" />"
  },
  "accessibility": {
    "contrast": "Body ink (#1A1C1F) on white and dock icons (#C4C7CE/#F7F8FA) on #1E2025 must meet WCAG AA for UI text.",
    "focusVisible": "Always show focus rings (soft blue) on keyboard navigation; never rely on hover-only affordances.",
    "touchTargets": "Minimum 36px for toolbar icons; 40px for dock primary +; 44px preferred for form controls.",
    "motion": "Respect prefers-reduced-motion: disable dock slide and badge pulse animations."
  }
}
